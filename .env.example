# NightAuth Customer Portal (PHP) Configuration

# Base URL of your NightAuth instance
NIGHTAUTH_API_URL=http://localhost:13100

# Portal Application ID
PORTAL_ID=demo-app

# Port on which the PHP Customer Portal will run
PORT=8080

# Default portal language (en, es, fr, de, it, pt, ru, tr, pl, zh)
DEFAULT_LANG=en
